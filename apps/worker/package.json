{
  "name": "worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "QMULATE background worker. Boots the pg-boss transport (landed S10/T1, not Sprint 9 as once planned) on PGBOSS_DATABASE_URL when present \u2014 queue role qmulate_pgboss, schema pgboss, empty handler registry until the T2 caller lands \u2014 and stays a validate-env-and-exit shell without it.",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup src/index.ts --format esm --out-dir dist",
    "start": "node dist/index.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --mode integration"
  },
  "dependencies": {
    "@qmulate/api": "workspace:*",
    "@qmulate/config": "workspace:*",
    "@qmulate/database": "workspace:*",
    "@qmulate/domain": "workspace:*",
    "@qmulate/jobs": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "^8.20.0",
    "pg": "^8.23.0",
    "tsup": "^8.5.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
