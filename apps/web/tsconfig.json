{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@qmulate/config/tsconfig/nextjs.json",
  "compilerOptions": {
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    "next.config.ts",
    "tailwind.config.ts",
    "playwright.config.ts"
  ],
  "exclude": ["node_modules", ".next", ".turbo", "playwright-report", "test-results"]
}
