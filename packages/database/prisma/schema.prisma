enum GovernmentPlatform {
  AWQAF_DIGITAL
  BALADI
  EJAR
  ISTIHKAM
  MUQEEM
  QIWA
}

/// The unified-framework's three workstreams.
enum ComplianceSection {
  FINANCIAL
  OPERATIONAL
  GOVERNMENT_LEGAL
