/// §09 adds RETIRED / NOT_APPLICABLE — obligations are never deleted, only retired.
enum ComplianceTaskStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  RETIRED
  NOT_APPLICABLE
}

/// §09 Engine A's `instantiatedReason` — WHY a task row exists. `INITIAL_SETUP` = the one-time
/// register generation once classification is set (A1); `RECLASSIFICATION` = added by a
/// classification change's diff (A4); `EVENT_TRIGGER` = raised by its trigger (the five event
/// templates §09 names — vocabulary shipped with the engine, the trigger wiring is E8-adjacent
/// and no path writes it yet, declared in the E7-completion stage log).
enum TaskInstantiationReason {
  INITIAL_SETUP
  RECLASSIFICATION
  EVENT_TRIGGER
  /// S9-3b (owner ruling 2026-08-25, S9 first batch): a duty attached to an ALREADY-instantiated
  /// register by the explicit maker≠checker act — never by a version bump alone. Rows with this
  /// reason MUST carry `instantiatedByApprovalId` (CHECK, migration 39) and the database
  /// re-verifies the approval at the row (`compliance_task_library_upgrade_authority`).
  LIBRARY_UPGRADE
}

/// §09 Engine B's material-change trigger kinds — the three §09 names, closed:
/// *"an asset added/disposed/substituted, a beneficiary added/removed/status-changed, or a
/// trusteeship/Nazarah change"*. NO `OTHER` member, deliberately: an unclassifiable material
/// change is one nobody can say what filing it belongs to, and a catch-all is where those go to
/// stop being looked at.
/// §09's BR-1004 escalation path, closed and in order: owner (Case Manager) → Nazir → Leadership.
///
/// The PATH is fixed vocabulary, NOT configuration — a ladder that reached Leadership before the
/// Nazir is a mis-assembled config, not a policy. Only WHEN each rung engages is configurable
/// (`deadline.escalationLadderBd` and its zero-tolerance twin). Spelled to match the domain's
/// `ESCALATION_LEVELS`, and pinned against it.
enum EscalationLevel {
  CASE_MANAGER
  NAZIR
  LEADERSHIP
}

enum MaterialChangeKind {
  ASSET
  BENEFICIARY
  NAZARAH
}

enum ApprovalType {
  BANK_MOVEMENT
  DISTRIBUTION_RUN
  GOVT_FILING
  /// S9-3b: "apply library vN to this register" — per endowment, maker≠checker, subject
  /// `library:<version>`. NOT a reserved matter (S8-Q12: catalogue/register upkeep is not
  /// retiring an endowment's record).
  LIBRARY_UPGRADE
  RESERVED_MATTER
}

/// NON-TERMINAL = `PENDING` | `APPROVED`. TERMINAL = `REJECTED` | `EXECUTED` | `VOID`.
/// The transition lattice is enforced by the `approval_request_authority` trigger, not by
/// application code: PENDING → APPROVED | REJECTED | VOID, APPROVED → EXECUTED | VOID, and
/// nothing leaves a terminal state.
///
/// `VOID` was added in E2 (migration `00000000000003_e2_authority_guards`). §10 §4.3 says that
/// when the approved subject changes after approval "the prior approval is **voided** and the item
/// returns to re-submit" — and until E2 that was not a REPRESENTABLE state, so the only ways to
/// express it were to leave a stale APPROVED row standing (a live second authority) or to rewrite
/// history. Neither is acceptable, so the state now exists.
enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  EXECUTED
  VOID
}

