// ═══════════════════════════════════════════════════════════════════════════
// 11. IDENTITY, ACCESS MATRIX & MAKER-CHECKER (§07 §11)
//
// better-auth OWNS `User`, `Session`, `Account`, `Verification`, `TwoFactor`. They live in
// THIS file (one schema per datasource) but their column names are dictated by the installed
// better-auth Prisma adapter. If the adapter's expectations differ from what is written here,
// the AUTH agent reports the delta and the DATABASE agent applies it — two agents must never
// both edit these five models.
// ═══════════════════════════════════════════════════════════════════════════

model User {
  // ── better-auth core fields ───────────────────────────────────────────────
  id               String   @id
  name             String
  email            String   @unique
  emailVerified    Boolean  @default(false)
  image            String?
  // ── better-auth twoFactor plugin ─────────────────────────────────────────
  /// TOTP is MANDATORY for money-movement and filing roles (NFR-06).
  /// Nullable to match `@better-auth/cli generate` exactly — the plugin treats this as an
  /// optional column and a non-null constraint here would reject its own writes. Read it with
  /// `hasTotpEnrolled()` (`=== true`), never as a bare truthiness check.
  twoFactorEnabled Boolean? @default(false)
  // ── QMULATE domain fields ────────────────────────────────────────────────
  locale           String   @default("ar")
  isActive         Boolean  @default(true)

  sessions      Session[]
  accounts      Account[]
  twoFactors    TwoFactor[]
  memberships   Membership[]
  grants        WaqfAccessGrant[]
  notifications Notification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("user")
}

model Session {
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId             String
  providerId            String
  password              String?
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

/// TOTP enrolment state (better-auth `twoFactor` plugin). NFR-06: mandatory for the
/// money-movement and statutory-filing seats — see `TOTP_REQUIRED_ROLES` in `@qmulate/auth`.
///
/// The field list is NOT hand-written: it is `@better-auth/cli generate` output for the pinned
/// better-auth version. `verified`, `failedVerificationCount` and `lockedUntil` are written by
/// the plugin's own enable/verify path, so omitting any of them makes TOTP enrolment fail at
/// runtime with a Prisma validation error (it did). Re-run the CLI and diff this model whenever
/// better-auth is upgraded.
///
/// `createdAt`/`updatedAt` are deliberately absent — better-auth does not supply them for this
/// model and Prisma would reject the insert on a required column.
model TwoFactor {
  id                      String    @id
  userId                  String
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  secret                  String
  backupCodes             String
  verified                Boolean?  @default(true)
  failedVerificationCount Int?      @default(0)
  lockedUntil             DateTime?

  @@index([userId])
  @@index([secret])
  @@map("two_factor")
}

/// Family-level access — the Family Board sees the whole family (all waqifs, all endowments).
///
/// ⚠ A CLIENT-LEVEL ROW CAN NEVER CONFER AN OPERATIONAL SEAT. §10 principle 2: "Scope is the
/// endowment, not the client … never per-family." Sprint 1 accepted ALL THIRTEEN `Role` values
/// here, with no `revokedAt`, no `validFrom`/`validUntil` and only `deletedAt` — so one row could
/// mint a `NAZIR` role string spanning every endowment of the family, that never expires and
/// cannot be revoked except by soft-delete. Migration `00000000000003_e2_authority_guards` adds
/// CHECK `membership_role_family_level_only`, which restricts `role` to `FAMILY_BOARD`. Widening
/// that list is a governance decision, not a convenience: any seat that touches money, filings or
/// approvals must be a per-endowment `WaqfAccessGrant`.
model Membership {
  id       String @id @default(cuid())
  userId   String
  user     User   @relation(fields: [userId], references: [id])
  clientId String
  client   Client @relation(fields: [clientId], references: [id])
  role     Role

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  deletedAt DateTime?

  @@unique([userId, clientId, role])
  @@index([userId])
  @@index([clientId])
  @@map("membership")
}

/// THE per-endowment access matrix (NFR-05). Authorization is
/// `(subject, role, waqfId) -> permitted actions`, enforced in `packages/api` on every
/// procedure and mirrored by the fail-closed Prisma scoping extension in `packages/database`.
///
/// ── THIS TABLE IS THE AUTHORIZATION PLANE, NOT ORDINARY ENDOWMENT DATA (E2) ───────────────────
/// Sprint 1 classified it in `WAQF_DIRECT_SCOPED_MODELS`, so the force-filter treated it like a
/// lease or an asset: any caller holding any write-capable grant on endowment A could INSERT a
/// `NAZIR` grant for THEMSELVES on A, with no admin, no approval and no gate — a live
/// second-approval-authority path. Migration `00000000000003_e2_authority_guards` closes it at the
/// database, and `extensions/scoping.ts` adds an authorization-plane write policy above it:
///
///   • CHECK   `waqf_access_grant_no_self_issue`   — `grantedByUserId <> userId`; a self-issued
///     grant is unrepresentable, whoever issues the statement
///   • CHECK   `waqf_access_grant_aml_flags`       — `canViewAmlRestricted` cannot be true while
///     `amlCompartment` is false; two booleans that must agree, now compared
///   • TRIGGER `waqf_access_grant_role_immutable`  — `role` is write-once. Escalation is only
///     expressible as revoke + re-issue, which is audited and admin-gated.
///   • TRIGGER `waqf_access_grant_permission_guard` — only `NAZIR` may hold a permission whose
///     verb is `approve` or `sign`; every string must be a three-segment `module:resource:verb`
///     with a verb from the closed set; wildcards are refused. `packages/domain`'s
///     `assertGrantPermissionsWithinPreset` is the full ceiling — this is the half that survives
///     raw SQL.
model WaqfAccessGrant {
  id                   String    @id @default(cuid())
  userId               String
  user                 User      @relation(fields: [userId], references: [id])
  waqfId               String
  waqf                 Waqf      @relation(fields: [waqfId], references: [id])
  role                 Role
  /// "module:resource:verb" tuples
  permissions          String[]
  /// e.g. ["finance","beneficiary","aml"]
  dataScopes           String[]
  canViewAmlRestricted Boolean   @default(false)
  /// AML no-tipping-off compartment membership for this endowment (BR-604).
  amlCompartment       Boolean   @default(false)
  /// Beneficiary users are PINNED to their own record only — they can never enumerate
  /// co-beneficiaries or other endowments (§10 §5, applied before role logic).
  beneficiarySelfId    String?
  /// Additional narrowing refs (e.g. asset ids for a subcontractor).
  scopeRefs            String[]
  /// Plain column, not an FK — avoids a second back-relation array on User.
  grantedByUserId      String
  validFrom            DateTime
  validUntil           DateTime?
  revokedAt            DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  deletedAt DateTime?

  @@unique([userId, waqfId, role])
  @@index([waqfId])
  @@index([userId])
  @@map("waqf_access_grant")
}

/// Maker-checker / reserved matters (BR-506, BR-1102).
///
/// ── SEGREGATION OF DUTIES, NOW ACTUALLY ENFORCED (E2) ────────────────────────────────────────
/// Sprint 1 shipped this doc comment claiming "`checkerId` must never equal `makerId`; the check
/// is re-verified at commit" and marked the field `/// Enforced: checker != maker` — and NOTHING
/// implemented it: no CHECK, no trigger, no code. A claimed enforcement with no implementation is
/// worse than an unclaimed gap, because a reader stops looking. Migration
/// `00000000000003_e2_authority_guards` makes the claim true, in POSTGRES, so it survives
/// `$executeRawUnsafe` and `session_replication_role = 'replica'`:
///
///   • CHECK  `approval_request_checker_ne_maker`     — self-approval is unrepresentable
///   • CHECK  `approval_request_decided_requires_checker`
///   • CHECK  `approval_request_approved_binds_payload` — an approval names the artifact it approved
///   • TRIGGER `approval_request_authority`           — a decided row's `checkerId` must resolve to
///     an ACTIVE `NAZIR` `waqf_access_grant` on the SAME `waqfId`, and the status transition must
///     be legal. The Nazir is the sole approval authority, per endowment, and never the maker.
///   • UNIQUE `approval_request_one_open_per_subject`  — at most one non-terminal row per
///     (waqfId, type, subject), so "the approval" is never ambiguous.
///
/// An APPROVED `RESERVED_MATTER` row is the ONLY thing that can unlock a reserved-matter column
/// (via `withReservedMatter`) — and per the 2026-07-27 user decision it can NEVER unlock the Shart
/// al-Waqif columns, which are now unconditionally immutable at the database. See
/// `src/reserved-matter.ts`.
model ApprovalRequest {
  id                      String              @id @default(cuid())
  waqfId                  String
  waqf                    Waqf                @relation(fields: [waqfId], references: [id])
  type                    ApprovalType
  /// WHAT reserved act this approves (BR-306 + CLAUDE.md's reserved matters). Before S4 an
  /// `ApprovalRequest` of type `RESERVED_MATTER` did not say what it authorised at all.
  ///
  /// ⚠ **NULLABLE, AND NOT YET MANDATORY ON A `RESERVED_MATTER` ROW — a MEASURED gap, not an
  /// oversight.** The CHECK this column wants is
  /// `("type" = 'RESERVED_MATTER') = ("reservedMatterKind" IS NOT NULL)`. It is NOT installed,
  /// because `packages/api`'s `approval.initiate` mints `RESERVED_MATTER` rows today without a kind
  /// (root.ts), `packages/api/src/routers/settings.ts` sets `SETTING_CHANGE_APPROVAL_TYPE =
  /// 'RESERVED_MATTER'` for every routine settings change, and three integration files
  /// (`approval-authority`, `grant-admission`, `shart-immutability`) insert such rows raw. Landing
  /// the mandatory CHECK from `packages/database` alone would redden files this change does not own
  /// — the same reasoning migration 4 §3.4 used for the `approval_request` hard-delete residue.
  /// What IS installed is the safe half: CHECK `reservedMatterKind IS NULL OR type =
  /// 'RESERVED_MATTER'` — a kind may only appear on a reserved-matter approval.
  /// ⚠ REPORTED AS OWED: add the biconditional CHECK in one coordinated change once every minting
  /// path sets the field.
  reservedMatterKind      ReservedMatterKind?
  payload                 Json
  status                  ApprovalStatus
  makerId                 String
  /// Enforced by CHECK `approval_request_checker_ne_maker` AND by trigger
  /// `approval_request_authority` (must be an ACTIVE NAZIR grant on the same endowment).
  ///
  /// ⚠ **WRITE-ONCE ONCE SET, AS OF MIGRATION 22 §2 — with `decidedAt`, `decidedAtHijri` and
  /// `checkerTotpAssertedAt`, together THE DECISION.** Migration 4 sealed WHAT WAS ASKED (waqfId,
  /// type, makerId, subjectId, payload, payloadHash) and left WHO DECIDED unsealed, and the lattice
  /// cannot see the gap because it is gated on a status CHANGE — so `APPROVED → APPROVED` with a
  /// different Nazir was unchecked. MEASURED (AV7-B/D1/D1c): two Nazirs approving one PENDING request
  /// concurrently BOTH received a success carrying their own id, three `APPROVE` events landed for one
  /// approval, and the surviving `checkerId` varied across runs; separately, a raw swap rewrote the
  /// recorded approver of a run that had ALREADY PAID while its `APPROVE` audit event went on naming
  /// the original. NULL → value is the decision being taken; value → anything else is a SECOND
  /// decision and raises 42501. **The seal is what closes the race**: `resolveApprover` reads the row
  /// outside the write transaction and takes no lock, so the application check is a TOCTOU by
  /// construction — the loser now blocks on the row lock, re-reads `OLD` as decided, and is refused.
  checkerId               String?
  /// The id of the thing being approved — the `distribution.id`, the `transaction.id`, the
  /// reserved-matter subject. Plain column, not an FK: one approval type can point at several
  /// tables, and an approval must survive its subject.
  ///
  /// Load-bearing for `approval_request_one_open_per_subject`: the partial unique index keys on
  /// `COALESCE("subjectId", '')`, so LEAVING THIS NULL means "at most one open request of this
  /// type on this endowment" rather than "unlimited". That is the fail-closed direction — two
  /// simultaneously-valid approvals for one act is a second authority by arithmetic.
  subjectId               String?
  /// Canonical hash of the approved artifact — `computeHash(canonicalJson(subject))` from
  /// `src/hash-chain.ts`; do NOT write a second canonicaliser. Recomputed at approve time and at
  /// execute time so the approver provably signed the artifact they saw (§10 §4.3). A mismatch
  /// voids the approval (`ApprovalStatus.VOID`) instead of executing a changed payload — whoever
  /// changes the lines after approval would otherwise be the real approver.
  payloadHash             String?
  /// When the checker last asserted a fresh TOTP (NFR-06 step-up). Recorded as EVIDENCE; the
  /// freshness WINDOW is `Setting['auth.totpStepUp.freshnessSeconds']` and is evaluated in the
  /// procedure layer, because a CHECK constraint cannot read a Setting.
  ///
  /// ⚠ WRITE-ONCE ONCE SET (migration 22 §2) — see `checkerId`. Rewriting a recorded assertion
  /// instant forges step-up freshness after the fact, which is the one thing this column exists to
  /// make unforgeable.
  checkerTotpAssertedAt   DateTime?
  counselReviewRequired   Boolean             @default(false)
  authorityNoticeRequired Boolean             @default(false)
  /// The Authority reference recorded when the reserved matter was notified/approved.
  authorityReference      String?
  /// ⚠ WRITE-ONCE ONCE SET, BOTH HALVES (migration 22 §2) — see `checkerId`. Sealing one calendar
  /// and not the other would permit a pair that disagrees about when the authority was exercised,
  /// which is worse than either alone (`waqf_reversion_recorded_dual_dated`'s precedent).
  decidedAt               DateTime?
  decidedAtHijri          String?

  /// ═══════════════════════════════════════════════════════════════════════════════════════════
  /// THE BR-1102 CHAIN — S12-2 (migration 51). Three RECORDED FACTS, each write-once once set.
  /// ═══════════════════════════════════════════════════════════════════════════════════════════
  /// §10 §9, verbatim: *"initiator → `family_board` principal approval → `counsel` review → Authority
  /// approval/notice where required → `nazir` S*. The engine disables the `nazir` sign action until
  /// every prior step is recorded complete, and names the missing step when blocked."* Until S12-2
  /// there was NO COLUMN for principal consent or for the review itself, and `chainState()` reported
  /// `NOT_RECORDED` unconditionally — the honest S4 skeleton. These are the columns.
  ///
  /// SCOPE — a KINDED `RESERVED_MATTER` (`reservedMatterKind IS NOT NULL`). Owner ruling 2026-09-08,
  /// verbatim *"every matter"*: counsel review is required on every reserved matter, so
  /// `counselReviewRequired` is forced `true` on a kinded row (CHECK
  /// `approval_request_kinded_requires_counsel_review`) and principal consent is required
  /// unconditionally. The Authority step is conditional on `authorityNoticeRequired`. A KINDLESS
  /// `RESERVED_MATTER` row — today the routine settings change in `routers/settings.ts` — carries
  /// no chain and stays maker≠checker only. ⚠ SURFACED, NOT DECIDED (S12 Q8): whether a settings
  /// change is a reserved matter at all; the honest fix is its own `ApprovalType`.
  ///
  /// ENFORCED THREE WAYS, none of them a doc comment: (1) CHECK
  /// `approval_request_kinded_decision_requires_chain` — a kinded row cannot BE APPROVED/EXECUTED
  /// with a step missing (row-local, survives raw SQL and the owner); (2) the transition trigger
  /// refuses `PENDING → APPROVED` on a kinded row naming the first missing step; (3)
  /// `qmulate_approval_defect()` refuses to SPEND one at the door. The app refuses before the write
  /// with `RESERVED_MATTER_CHAIN_INCOMPLETE`, naming the steps.
  ///
  /// WHO RECORDS (owner ruling 2026-09-08, *"staff"*): a holder of `legal:reserved_matter:write`
  /// records the received written approval / review against a REFERENCE (the letter's own
  /// reference, or a vault `Document.id` when one is attached — validated to exist on THIS endowment
  /// when supplied). A `family_board` seat may also record consent directly. `…By` is the acting
  /// identity from the session, never an input. Each `RecordedAt/Hijri` pair moves together
  /// (ADR-0007), and each is write-once once set — re-recording a step is a second decision.
  principalConsentRecordedAt      DateTime?
  principalConsentRecordedAtHijri String?
  principalConsentBy              String?
  principalConsentReference       String?
  counselReviewRecordedAt         DateTime?
  counselReviewRecordedAtHijri    String?
  counselReviewBy                 String?
  counselReviewReference          String?
  /// The Authority step re-uses `authorityReference` above as its reference (required when recorded).
  authorityNoticeRecordedAt       DateTime?
  authorityNoticeRecordedAtHijri  String?
  authorityNoticeBy               String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  deletedAt DateTime?

  @@index([waqfId, status])
  @@index([waqfId, type, subjectId])
  @@map("approval_request")
}

// ═══════════════════════════════════════════════════════════════════════════
// 12. CROSS-CUTTING: audit spine, config, calendar, notifications (§07 §12, §12 spec)
// ═══════════════════════════════════════════════════════════════════════════

/// APPEND-ONLY, TAMPER-EVIDENT (NFR-04). Written INSIDE the same transaction as the change it
/// describes, so an event and its subject commit or roll back together.
///
/// NO `updatedAt`, NO `deletedAt`, NO soft-delete — this table is never mutated.
/// Enforced at the DATABASE, not in application code:
///   • `audit_event_no_mutate` — a BEFORE UPDATE OR DELETE OR TRUNCATE **statement** trigger
///     that raises SQLSTATE 42501 unconditionally. This is the LOAD-BEARING control: on
///     Railway the runtime usually connects as the database OWNER, and an owner bypasses
///     GRANTs but NOT triggers.
///   • role `qmulate_app_runtime` holds SELECT + INSERT only; UPDATE/DELETE/TRUNCATE are
///     revoked. Defence-in-depth for a future dedicated non-owner login role.
///
/// HASH CHAIN: `rowHash = sha256_hex( utf8(canonicalJSON(payload)) || utf8(prevHash) )`,
/// lowercase hex, 64 chars; genesis `prevHash` = 64 zeroes. The payload is EXACTLY these 14
/// immutable fields: id, occurredAt, actorId, actorType, onBehalfOfId, action, entityType,
/// entityId, waqfId, before, after, context, category, classification.
/// (DELIBERATE DEVIATION from §12, which lists 10 and omits waqfId / actorType /
/// onBehalfOfId / category. Omitting `waqfId` would let a tamperer re-scope an event to
/// another endowment undetected, so all four are bound into the hash. Needs a one-line §12
/// amendment.)
///
/// `before`/`after` carry ONLY the keys that changed, and hold CIPHERTEXT for encrypted
/// columns — never plaintext — so the trail never becomes a PII sink. Money is serialized as
/// its Decimal(18,2) string form; `canonicalJSON` THROWS on a JS `number`.
///
/// Itself subject to the >= 10-year retention rule; never purged while any endowment it
/// references is live or under legal hold.
/// ⚠ unverified — confirm vs primary law (the retention floor)
model AuditEvent {
  id              BigInt              @id @default(autoincrement())
  occurredAt      DateTime            @default(now())
  occurredAtHijri String
  /// better-auth user id; null only for system/job actors (then `actorType = SYSTEM`).
  actorId         String?
  actorType       AuditActorType
  /// Set when an authorized-representative Nazir acts under delegation (BR-105) —
  /// joint-and-several accountability is visible in the trail.
  onBehalfOfId    String?
  action          AuditAction
  /// e.g. "Waqf", "Distribution", "Beneficiary", "GovernmentFiling", "Document"
  entityType      String
  entityId        String
  /// Denormalized for the per-endowment access matrix and evidence-pack scoping.
  /// Plain column, not an FK — the trail must survive its subject.
  waqfId          String?
  before          Json?
  after           Json?
  /// Request id, IP, user-agent, tRPC procedure, reason/justification, and
  /// `reservedMatterApprovalId` when the write went through `withReservedMatter`.
  context         Json
  category        AuditCategory
  classification  AuditClassification @default(ROUTINE)
  prevHash        String              @db.Char(64)
  rowHash         String              @db.Char(64)

  @@unique([rowHash])
  @@index([waqfId, occurredAt])
  @@index([entityType, entityId])
  @@index([actorId, occurredAt])
  @@index([action, occurredAt])
  @@map("audit_event")
}

/// Singleton chain head (`id` is pinned to 1 by the `audit_chain_head_singleton` CHECK).
/// Read + updated under one `pg_advisory_xact_lock` per audited transaction so concurrent
/// writers serialize and the chain can never fork. O(1) — no ORDER BY over the whole table.
model AuditChainHead {
  id          Int      @id @default(1)
  lastId      BigInt   @default(0)
  lastRowHash String   @db.Char(64)
  updatedAt   DateTime @updatedAt

  @@map("audit_chain_head")
}

/// Runtime configurability (NFR-13). Global rows have `waqfId = null`; a per-waqf row
/// overrides the global one.
///
/// EVERY regulatory figure in this system lives HERE, never as a code constant, so a
/// correction is a config change and not a deploy: the SAR 200M / 50M classification bands,
/// the 30 / 15 / 10-business-day windows, the 3-month post-FY-end distribution window, the
/// >= 10-year retention floor, the KYC refresh interval, the deed-set ʿushr Nazir fee, and the
/// Authority's separate <= 10%-of-net-income fee.
///
/// `value` is an envelope so the staleness marker travels with the data:
///   { "v": <value>, "unit": <string|null>, "unverified": <bool>, "source": <string>,
///     "note": "⚠ unverified — confirm vs primary law" }   // `note` present iff `unverified`
///
/// NOTE: `@@unique([waqfId, key])` alone does NOT prevent duplicate GLOBAL rows (Postgres
/// treats NULLs as distinct), so the constraints migration adds a partial unique index
/// `setting_global_key_unique ON "setting" ("key") WHERE "waqfId" IS NULL`.
/// ⚠ unverified — confirm vs primary law
model Setting {
  id     String  @id @default(cuid())
  /// null = global
  waqfId String?
  waqf   Waqf?   @relation(fields: [waqfId], references: [id])
  key    String
  value  Json

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  deletedAt DateTime?

  @@unique([waqfId, key])
  @@index([key])
  @@map("setting")
}

/// KSA business-day calendar: Fri/Sat weekend + Hijri-moving public holidays.
/// Feeds the deadline engine's business-day arithmetic.
/// ⚠ unverified — confirm vs primary law (holiday set and workweek)
model HolidayCalendar {
  id           String   @id @default(cuid())
  date         DateTime @unique
  dateHijri    String
  /// Arabic-authoritative (NFR-01)
  nameAr       String
  nameEn       String?
  isWorkingDay Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("holiday_calendar")
}

model Notification {
  id      String    @id @default(cuid())
  userId  String
  user    User      @relation(fields: [userId], references: [id])
  /// Plain column, not an FK — a notification may reference a waqf the user has since lost
  /// access to; the scoping extension narrows Notification by `userId`, not by waqf.
  waqfId  String?
  kind    String
  payload Json
  readAt  DateTime?

  createdAt DateTime @default(now())

  /// ⚠ TWO CONSTRAINTS LIVE IN RAW SQL (migration 45, S10/T2) BECAUSE PRISMA CANNOT EXPRESS THEM:
  /// a partial UNIQUE EXPRESSION index — at most one 'deadline.reminder' row per
  /// (userId, payload->>'idempotencyKey') — and a CHECK that a reminder-kind row carries a
  /// non-empty key (NULLs do not conflict in a unique index, so the CHECK is what closes the
  /// key-less trapdoor). The reminder dedupe's FLOOR is the database, not the read-then-write
  /// check in deadline.evaluate; a violating concurrent writer's transaction aborts and the
  /// transport retry converges. 'deadline.escalation' notices deliberately have no floor here —
  /// they ride migration 41's escalation_event index transitively (same transaction).
  @@index([userId])
  @@index([userId, readAt])
  @@map("notification")
}
