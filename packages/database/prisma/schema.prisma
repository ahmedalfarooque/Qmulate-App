  /// must survive vendor de-listing.
  vendorId      String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  deletedAt DateTime?

  @@index([assetId])
  @@index([vendorId])
  @@map("maintenance_ticket")
}

/// P-01..P-06 subcontractors (BR-305). GLOBAL — deliberately NOT waqf-scoped.
model Vendor {
