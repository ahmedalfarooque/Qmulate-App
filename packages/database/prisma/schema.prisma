// QMULATE — Phase 1 data model (E1 / Sprint 1)
//
// Contract sources: docs/product/prd/07-data-model-spec.md (§1–§13),
// docs/product/prd/12-security-audit-retention-spec.md (audit spine, encryption, retention),
// docs/product/prd/17-build-ship-dod.md (E0/E1 exits, G-1, G-8), and the Sprint-1 E1 build contract.
//
// FOUR CONVENTIONS GOVERN THIS WHOLE FILE (§07 preamble):
//   1. Money is NEVER a float. Every amount is `Decimal @db.Decimal(18,2)`, currency SAR.
//      JS `number` is banned for money end-to-end (decimal.js in TS).
//   2. Every legally-significant date is DUAL: canonical `xAt/xDate DateTime` (UTC — the
//      arithmetic + sort source of truth) PLUS a frozen `...Hijri String` Umm-al-Qura snapshot
//      ("yyyy-MM-dd", Latin digits, zero-padded) written at insert time, so historical display
//      never shifts when a calendar library updates.
//   3. Official financial/legal free text is ARABIC-AUTHORITATIVE: the `...Ar` field is REQUIRED
//      and is the system of record; `...En` is an optional convenience translation.
//   4. Scoping and audit are cross-cutting. Every material model is reachable from a `waqfId`
//      (directly, or one hop via its parent) for the per-endowment access matrix, and every
//      mutation flows through the append-only audit extension in `packages/database`.
//
// NAMING: table names are snake_case singular via `@@map`; COLUMN names stay Prisma camelCase.
// Therefore ALL raw SQL against this schema must double-quote column identifiers.
//
// AUDIT4: `createdAt` / `updatedAt` / `createdBy` / `deletedAt` on every material model.
// Deletion is SOFT ONLY during the retention window (§12) — `deletedAt`, never a hard DELETE.

generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ═══════════════════════════════════════════════════════════════════════════
// 1. ENUMS — the domain's controlled vocabulary (§07 §1 + E1 contract §A)
// ═══════════════════════════════════════════════════════════════════════════

/// Gates which compliance obligations apply.
/// Band thresholds (SMALL < SAR 50M · MEDIUM 50M–<200M · LARGE >= 200M) live in `Setting`,
/// never in code.
/// ⚠ unverified — confirm vs primary law
/// The Authority's SIZE classification — THREE values, plus the onboarding state.
///
/// ⊕ **S9-4a: `DIRECT_UTILIZATION` IS GONE FROM THIS ENUM (owner ruling, fifth batch, 2026-08-25,
/// verbatim selection "a").** The owner stated the taxonomy in his own words first — *"there are 3
/// types: large, medium, small"* — and then ruled that ذات انتفاع مباشر is an **ORTHOGONAL USAGE
/// ATTRIBUTE, not a size**: an endowment could be small AND direct-use. Carrying it here conflated
/// two axes, so a direct-use endowment had no size at all and a small one could not be direct-use.
///
/// ⚠ **REFUSED, NEVER REMAPPED (ADR-0004).** Migration 42 does not reassign existing rows to a
/// plausible size — it REFUSES to run over any row holding the value, on `waqf` and on
/// `reclassification_event`'s `from`/`to` alike. Choosing a size for a real endowment is a
/// regulatory determination, not a data migration, and a silent remap would put a classification
/// nobody made into the record that gates its statutory duties.
///
/// ⚠ Size thresholds stay ⚠ unverified vs primary law (the SAR 200M/50M bands live in `Setting`),
/// and counsel is still owed the question the ruling itself flags: the regulation summary reads the
/// instrument as FOUR categories while the owner (a practising Nazir) reads direct-benefit as an
/// attribute. This enum records the PRODUCT's position.
enum WaqfClassification {
  LARGE
  MEDIUM
  SMALL
  /// ⊕ S8-Q4 (owner, 2026-08-23): the ONBOARDING state, stated rather than NULL. The absence of a
  /// determination, not a class — it never gates an obligation TRUE and the register is LOCKED
  /// (no tasks instantiate) until the real classification is recorded. One-way: an endowment may
  /// be BORN in it; `waqf_no_unclassify` + the reclassification `to`-check (migration 34) refuse
  /// the return trip.
  NOT_CLASSIFIED
}

/// khayrī (public-charitable) · ahlī-dhurrī (family) · mushtarak (joint)
enum WaqfType {
  PUBLIC_CHARITABLE
  FAMILY_DHURRI
  JOINT
}

/// ʿaynī (in-kind) vs qiyamī (value / cash)
enum WaqfNature {
  AYNI
  QIYAMI
}

/// How the deed orders entitlement.
///
/// `LINEAGE_CONTINUATION` — **the NORMAL deed shape** (ADR-0009 R4): entitlement follows descent,
/// per capita over the LIVING FRONTIER of each line (R-FRONTIER, 2026-08-03). `ORDERED`
/// (al-aʿlā fa-l-aʿlā) is the **opt-in exception**, `SHARED` (tashrīk) a third order, and
/// `NA_DIRECT_USE` direct use of the asset itself.
///
/// ⚠ `LINEAGE_CONTINUATION` LANDED IN MIGRATION 12 (S4/E3) and closed the ONE declared delta
/// `packages/domain`'s `prisma-vocabulary-parity.test.ts` carried: the engine's `ENTITLEMENT_ORDERS`
/// held it while this enum did not, so a deed the product treats as normal could not be recorded at
/// all. Adding a member is additive — every existing row keeps its value.
///
/// ⚠ SURFACED, NOT DECIDED (S4): this column is a FOUNDER'S CONDITION carried in a freely-editable
/// column. It is not in `SHART_COLUMNS`, not in the reserved-matter tier and not in the write-once
/// tier migration 12 adds beside it, so a caller holding `endowment:waqf:write` can change
/// al-aʿlā fa-l-aʿlā to tashrīk with an ordinary update. `Waqf.type` and `Waqf.nature` have the
/// same shape. Bringing all three into the write-once/reserved tier is the recommendation; it
/// changes what a LIVE endowment permits, so it is the product owner's call and S4 did not take it
/// silently either way.
enum EntitlementOrder {
  LINEAGE_CONTINUATION
  ORDERED
  SHARED
  NA_DIRECT_USE
}

/// Generational lines: ẓuhūr / buṭūn / not-applicable
enum BeneficiaryLine {
  ZUHUR
  BUTUN
  NA
}

/// Which of the waqif's lines the DEED continues — *ẓuhūr wa buṭūn* / ظهور وبطون (ADR-0009 R2).
///
/// A **CLOSED TWO-VALUE** deed term. There is no third member and **NO `@default`** on the column
/// that uses it: absent, ambiguous or unrecognised ⇒ the engine halts `SHART_INCOMPLETE` /
/// `CONTINUATION_STIPULATION_UNRECOGNISED`. Which lines a founder continued is a fiqh reading of
/// the deed, and "unknown" is the ABSENCE of a value, never a value.
///
/// Spelled member-for-member as `packages/domain`'s `CONTINUATION_STIPULATIONS`, which
/// `prisma-vocabulary-parity.test.ts` compares.
enum ContinuationStipulation {
  ZUHUR_ONLY
  ZUHUR_AND_BUTUN
}

/// The fiqh link a descendant holds to their parent — the ẓuhūr/buṭūn **ELIGIBILITY FACT**.
///
/// ⚠ **NOT a demographic field and NOT a person's gender.** It exists for exactly ONE computation
/// (the `ZUHUR_ONLY` intermediate-ancestor test in the distribution engine), is read for that and
/// nothing else, and must NEVER be rendered as a person's gender: no UI label, no report column, no
/// CSV export, no i18n key. `null` on `Beneficiary.lineageLink` means "not a descendant of the
/// waqif" (a charitable jiha, including a recorded ultimate taker), never "unknown".
///
/// Kept as the RECORDED fact (`SON`/`DAUGHTER`) rather than pre-interpreted, because under
/// `ZUHUR_AND_BUTUN` the interpreted form carries no information at all — pre-interpreting would
/// bake one deed's reading into every deed's data.
enum LineageLink {
  SON
  DAUGHTER
}

/// **مآل الوقف** — where the endowment goes once its beneficiary class ends (R7, product owner
/// 2026-08-10; ADR-0009 amendment E).
///
/// ONE member today, and the discriminator exists *because* it is one: a deed may revert to another
/// waqf, to the Authority, or to the waqif's nearest relatives, and the engine implements only the
/// reading the owner gave. Any other recorded مآل must halt BY NAME
/// (`REVERSION_KIND_UNRECOGNISED`) rather than be coerced into this one (Binding rule 1).
enum ReversionKind {
  CHARITABLE_ULTIMATE_TAKER
}

/// ⊕ S11-1 — WHICH date `Waqf.registrationAnchorDate` IS (owner ruling 2026-08-31, memo S10 addendum
/// second batch, commit 9f3d8fd: *"yes sure, make a drop down if that helps"*).
///
/// §09's `REGISTER_30BD` clock starts on "the waqf documentation / regulation-effective date" — TWO
/// different facts, and a bare date preserves WHEN while discarding WHAT IT IS. ⊕ THE TWO VALUES ARE
/// THE REGULATION'S OWN DISJUNCTION, not a modelling choice: GOV-REG-01's titleAr in the compliance
/// catalogue reads *"…خلال مدة لا تتجاوز ثلاثين يوم عمل من تاريخ توثيقه لدى الجهة المختصة **أو** تاريخ
/// نفاذ اللائحة…"* — within thirty business days of the date of its documentation with the competent
/// authority OR the date the regulation takes effect. The enum names those two branches and no third.
/// (The thirty-day figure in that sentence stays unverified per binding rule 3; the disjunction is
/// what this validates, not the number.) The owner's stated
/// intent is to refine the governance of these dates later; a later refinement that cannot tell
/// which endowments were recorded on which basis would have to re-interview every one of them. So
/// the KIND travels with the date, as a CLOSED two-value term. NO DEFAULT anywhere: the pair is
/// recorded together or not at all (CHECK `waqf_registration_anchor_kind_pairs_with_date`).
///
/// ⚠ Which of the two GOVERNS a given endowment, and the 30-business-day window itself, are
/// UNVERIFIED against primary law (binding rule 3). This enum names the operator's declaration; it
/// does not rule on it.
enum RegistrationAnchorKind {
  WAQF_DOCUMENTATION_DATE
  REGULATION_EFFECTIVE_DATE
}

/// ⊕ S11-2 (migration 49) — HOW a statutory deadline was DISCHARGED. Owner ruling 2026-09-02 (S4 memo,
/// S11 addendum second batch, f797fea): a red registration deadline clears because the duty was MET,
/// recorded as a discharge — never by editing the clock-start. ONE member today. The vocabulary is
/// CLOSED and PINNED (`deadline-discharge-kind-vocabulary.test.ts`): a new member — the counsel
/// question could one day make NOT APPLICABLE the honest state of an endowment the duty never
/// attached to — arrives only with a deliberate pin edit, its own migration relaxing
/// `deadline_discharge_kind_pairs_with_met`, and its ar/en copy declared owed. `MET` pairs with
/// `Deadline.satisfiedAt` (CHECK both directions) and is write-once.
enum DeadlineDischargeKind {
  MET
}

/// WHAT a `RESERVED_MATTER` `ApprovalRequest` approves (BR-306 + the reserved matters CLAUDE.md
/// names). Before this enum an `ApprovalRequest` of type `RESERVED_MATTER` did not say what act it
/// authorised at all, which is half of why the reserved-matter door was over-permissive.
///
/// ⚠ The column that uses it is NULLABLE and NOT yet mandatory on a `RESERVED_MATTER` row — see
/// `ApprovalRequest.reservedMatterKind` for the measured reason and the one-line CHECK that closes
/// it once every minting path sets the field.
/// ⊕ S12-3 · BR-1101 — the operating model's three sequenced handover gates, in order. "Nothing
/// downstream proceeds until the prior gate clears" (docs/company/operating-model.md). The ORDER is
/// enforced by `onboarding_gate_order` (migration 52): Gate N may only be CLEARED while Gate N-1 is
/// CLEARED. What each gate MEANS is the operating model's list, carried as `evidence` on the row.
enum OnboardingGateKind {
  GATE_01_AUTHORITY_LEGAL
  GATE_02_SYSTEMS_CONTROLS
  GATE_03_PEOPLE_PROPERTY_CADENCE
}

/// `OPEN` is the state of every gate at intake. `CLEARED` is a recorded human act (who, when, on what
/// evidence). A cleared gate may be REOPENED by a Nazir with a reason (owner ruling 2026-09-08, "nazir
/// can reopen") — reopening only ever blocks MORE, so it is the safe direction and needs no approval.
enum OnboardingGateStatus {
  OPEN
  CLEARED
}

enum ReservedMatterKind {
  ASSET_DISPOSAL
  ASSET_SUBSTITUTION_ISTIBDAL
  ASSET_PLEDGE
  ASSET_LONG_LEASE
  DEED_IDENTITY
  DEED_TERM_RECORD
  ACCESS_MATRIX_CHANGE
  /// ⊕ Owner ruling Q-E5-1(b), 2026-08-18: a mis-classified receipt may be corrected, in BOTH
  /// directions, and EVERY such correction requires an approved reserved matter. It has its own
  /// kind because `executeReservedAct` COMPARES the kind — borrowing one of the seven above would
  /// be a mislabelled authority, which is worse than an unlabelled one.
  RECEIPT_CLASS_CORRECTION
  /// ⊕ Owner ruling, 2026-08-25 (S8 addendum, FOURTH batch — *"Allow return, reserved-matter-gated"*,
  /// recorded as ⚠ **overruling the orchestrator's recommendation**): an erroneous real
  /// classification MAY return to `NOT_CLASSIFIED` *"via a maker≠checker reserved-matter approval
  /// (e.g. a classification entered on the wrong endowment entirely). The one-way door gains exactly
  /// this gated exception; **the default refusal stands for the ungated path.**"*
  ///
  /// ⚠ ITS OWN KIND, AND THE NAME IS DELIBERATELY LONG. `RECEIPT_CLASS_CORRECTION`'s note above
  /// gives the rule — the kind is COMPARED, so a borrowed one is a mislabelled authority — and the
  /// tempting short name here (`CLASSIFICATION_CORRECTION`) is exactly that mislabel: an ORDINARY
  /// re-classification (MEDIUM → LARGE) is **not** reserved-matter-gated and never was. Only the
  /// return to the absence of a determination is. The name says which act it authorises so that an
  /// approval minted for one can never be spent on the other.
  ///
  /// ⚠ NOT a licence to edit history: the return is recorded as a further `reclassification_event`
  /// (append-only, `_no_delete` since migration 6, `_no_update` since migration 12), so the
  /// revocation is itself a recorded act rather than an erasure — which is the argument for why
  /// the door is safe, and it is stronger than "the owner ruled it".
  CLASSIFICATION_RETURN_TO_NOT_CLASSIFIED
}

/// The CLOSED state vocabulary of a corpus asset (product owner, 2026-08-16 — decisions log D-A:
/// *"I'm thinking the list will be: Active, Fully Occupied/Rented, partially rented, vacant,
/// expropriated/substituted."*).
///
/// ⚠ IT REPLACES A FREE-TEXT COLUMN THAT HAD ZERO CHECK CONSTRAINTS, and that is the whole point.
/// MEASURED before migration 13, as the least-privileged runtime role on a pristine seed:
/// `UPDATE "asset" SET "status" = 'مستبدل'` (the Arabic for *substituted*) COMMITTED with no
/// reserved-matter approval, while the Latin `'substituted'` on the same row was refused 42501 —
/// because `qmulate_asset_identity_guard()` gated an allow-list of twelve Latin SPELLINGS over a
/// `String` column, and **Arabic is this product's authoritative language (NFR-01)**. A longer list
/// has the identical defect, so the vocabulary is closed instead (V-E3-02).
///
/// ⚠ WHAT BECAME UNREPRESENTABLE, DELIBERATELY: `sold`, `pledged`, `mortgaged` and `long_leased`.
/// That is STRICTER than before and coherent with waqf perpetuity — corpus leaves an endowment by
/// istibdal or expropriation, not by sale.
///
/// ✓ CONFIRMED BY THE PRODUCT OWNER, 2026-08-17 (S4 owner-decision memo Q9), verbatim:
/// *"remove 'sold'. since an endowment asset cannot be sold, if expropriated by government - they
/// will replace with similar valued asset."*
///
/// `sold` WAS ALREADY UNREPRESENTABLE, SO NOTHING WAS REMOVED — and that was VERIFIED here rather
/// than read. MEASURED on the live catalogue (cluster `q8q10db`, migration 16 applied): the enum has
/// exactly the six labels below, and as the least-privileged role `UPDATE "asset" SET "status" =
/// 'sold'` is refused **22P02 invalid input value for enum "AssetStatus"** — at TYPE PARSE, before
/// any trigger runs — as is its Arabic spelling `'مبيع'`. What the ruling changes is WHOSE decision
/// the exclusion is: his, not engineering's caution. By extension (the memo's reading, not his own
/// words) it also confirms the six-value vocabulary INCLUDING the split below.
///
/// ⊕ NEW FACT FROM THE SAME ANSWER, recorded because nothing else in the repo carried it: **on
/// expropriation the government replaces the parcel with a SIMILAR-VALUED ASSET.** So the expected
/// flow is expropriation → replacement corpus asset, which is the `Expropriation` → istibdal model
/// this schema already has. The replacement asset — and any proceeds — are CORPUS (asl / أصل): a
/// receipt must be entered as `receiptClass = CAPITAL`, which the distribution waterfall excludes by
/// construction (Binding rule 1). The `EXPROPRIATED` status therefore records a taking, never a
/// disposal of value out of the endowment.
///
/// ⚠ `expropriated/substituted` IS SPLIT INTO TWO — engineering's refinement (D-A), confirmed only
/// BY EXTENSION in memo Q9's reading and not in the owner's own words, so the split is recorded as
/// his working vocabulary rather than as an explicit ruling on the split itself. An expropriation is
/// a government taking; an istibdal is the Nazir's own substitution and carries a ≤10-business-day
/// Authority notice (⚠ unverified — confirm vs primary law).
///
/// ⚠ THE ar/en LABELS ARE NOT HERE AND ARE STILL NOT DECIDED — memo Q9 did NOT address them, and the
/// memo says so ("The Arabic labels were not addressed and therefore stay flagged"). The strings in
/// `packages/i18n/messages/{ar,en}.json` are engineering's rendering of ordinary property terms, NOT
/// product-approved legal copy; they are owed to the same E10/E12 review path as the distribution
/// statement copy. Do not treat them as confirmed because the VALUES now are.
///
/// RESERVED (a transition INTO one needs an approved reserved matter — BR-306, enforced by
/// `qmulate_asset_identity_guard()`): `EXPROPRIATED`, `SUBSTITUTED_ISTIBDAL`.
enum AssetStatus {
  ACTIVE
  FULLY_RENTED
  PARTIALLY_RENTED
  VACANT
  EXPROPRIATED
  SUBSTITUTED_ISTIBDAL
}

enum VerificationStatus {
  VERIFIED
  PENDING
  UNVERIFIED
}

enum TxnType {
  REVENUE
  EXPENSE
}

enum ExpenseCategory {
  MAINTENANCE
  OPERATIONS
  NAZIR_FEE
  ZAKAT
  OTHER
}

/// BINDING RULE 1 (corpus/income segregation).
/// `asl` (أصل, corpus) and `ghallah` (غلة, income) are distinct and never mixed.
/// ONLY `INCOME`-class receipts may enter the distribution waterfall. `CAPITAL` receipts —
/// explicitly SALE and ISTIBDAL (substitution) proceeds — are corpus and are BLOCKED from
/// distribution; they flow back into corpus.
enum ReceiptClass {
  INCOME
  CAPITAL
}

/// Which corpus event produced a CAPITAL receipt. Required whenever `receiptClass = CAPITAL`
/// (enforced by a DB CHECK in the hand-written constraints migration).
enum CapitalSource {
  SALE_PROCEEDS
  ISTIBDAL_PROCEEDS
  EXPROPRIATION_COMPENSATION
  OTHER
}

/// Nazir remuneration basis. Set by the DEED (Nazarah Art. 11), not by statute.
/// ⚠ unverified — confirm vs primary law
enum FeeBasis {
  PERCENT_OF_REVENUE
  PERCENT_OF_NET_INCOME
  RETAINER
}

/// Which endowment classes an obligation applies to.
///
/// ⊕ S8-Q3 (product owner, 2026-08-23): "Adopt §09's five gates." `EXCLUDE_DIRECT` and `HAS_INCOME`
/// were used by §09's obligation-library table and existed in no enum, which left SEVEN of its 37
/// templates unrepresentable — including the distribution duty itself.
///
/// ⚠ `HAS_INCOME` IS A RUNTIME PREDICATE, not a class set. §09 says so in terms: it applies to any
/// class where the endowment records revenue or expense IN THE PERIOD. `packages/domain` therefore
/// keeps it OUT of `CLASSIFICATION_GATE_MATRIX` and makes looking it up there a compile error; the
/// resolver takes the ledger fact as a separate input and REPORTS its absence rather than defaulting
/// (false silently drops four obligations, true tells a moneyless endowment it owes bank
/// reconciliation).
///
/// ⚠ `LARGE_ONLY` IS RETIRED — refused, NOT remapped (the JOINT/ADR-0004 precedent). Zero §09 rows
/// and zero fixture rows ever used it, so there is nothing to migrate; the member stays so an old
/// record still reads, and the ENGINE refuses a catalogue row carrying it (its own bucket, never
/// folded into "excluded" — a silently excluded duty leaves no trace).
///
/// ⚠ unverified — confirm vs primary law
enum ClassificationGate {
  ALL
  LARGE_MEDIUM
  SMALL_DIRECT
  EXCLUDE_DIRECT
  HAS_INCOME
  LARGE_ONLY
}

/// Canonical filing-status set (§07 / §14). `ACCEPTED` = e.g. the Awqaf platform's "registered".
enum FilingStatus {
  NOT_STARTED
  IN_PROGRESS
  SUBMITTED
  ACCEPTED
  REJECTED
  N_A
}

/// The six authoritative government platforms (§07 §8). These are MANUAL status fields —
