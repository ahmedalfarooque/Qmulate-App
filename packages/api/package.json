    "test:integration": "vitest run --mode integration"
  },
  "dependencies": {
    "@qmulate/auth": "workspace:*",
    "@qmulate/config": "workspace:*",
    "@qmulate/database": "workspace:*",
    "@qmulate/domain": "workspace:*",
    "@qmulate/i18n": "workspace:*",
    "@qmulate/storage": "workspace:*",
    "@trpc/server": "^11.0.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "eslint": "^9.30.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
