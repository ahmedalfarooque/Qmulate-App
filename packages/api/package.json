{
  "name": "@qmulate/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "tRPC v11 request context and the RBAC procedure ladder for QMULATE: authed -> endowment-scoped -> maker / checker / signer, with beneficiary self-isolation, the AML no-tipping-off compartment, segregation of duties and denial auditing.",
