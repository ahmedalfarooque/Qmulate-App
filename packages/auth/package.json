{
  "name": "@qmulate/auth",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Self-hosted better-auth (email+password + mandatory TOTP for internal ops seats), the QMULATE role catalogue and the per-endowment session gate.",
  "exports": {
    ".": "./src/index.ts",
    "./server": "./src/server.ts",
    "./client": "./src/client.ts",
    "./rate-limit": "./src/rate-limit.ts",
    "./roles": "./src/roles.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@qmulate/config": "workspace:*",
    "@qmulate/database": "workspace:*",
    "@qmulate/domain": "workspace:*",
