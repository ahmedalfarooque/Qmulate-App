{
  "name": "@qmulate/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "QMULATE design tokens (light-neu / dark-neu / flat report), the Tailwind preset, and the shared React component library.",
  "exports": {
    ".": "./src/index.ts",
    "./tokens.css": "./tokens/tokens.css",
    "./tokens/tokens.css": "./tokens/tokens.css",
    "./tokens": "./tokens/tokens.ts",
    "./tokens/tokens": "./tokens/tokens.ts",
    "./tailwind-preset": "./tailwind-preset.ts",
    "./fonts": "./src/fonts.ts",
    "./fonts/*": "./fonts/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@qmulate/i18n": "workspace:*"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@qmulate/config": "workspace:*",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "decimal.js": "^10.4.3",
    "jsdom": "^26.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
