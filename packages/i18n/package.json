{
  "name": "@qmulate/i18n",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Bilingual ar/en message catalogues, RTL helpers, and locale-aware money and dual-calendar formatters shared by web, mobile and report renderers.",
  "exports": {
    ".": "./src/index.ts",
    "./config": "./src/config.ts",
    "./formatters": "./src/formatters.ts",
    "./rtl": "./src/rtl.ts",
    "./request": "./src/request.ts",
    "./messages/ar.json": "./messages/ar.json",
    "./messages/en.json": "./messages/en.json",
    "./package.json": "./package.json"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "next-intl": "^3.26.0"
  },
  "devDependencies": {
    "@qmulate/config": "workspace:*",
    "@types/node": "^22.10.0",
    "eslint": "^9.30.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
