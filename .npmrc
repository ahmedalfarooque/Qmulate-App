# QMULATE — pnpm configuration.
# Node/pnpm versions are pinned by .nvmrc and package.json#packageManager.

# Workspace packages are linked, not fetched from the registry.
link-workspace-packages=true
prefer-workspace-packages=true

# Keep the isolated node_modules layout (no phantom deps). packages/domain must
# not be able to accidentally resolve an undeclared internal package.
shamefully-hoist=false

# Peer handling: install peers automatically, but do not hard-fail the whole
# install on an unmet peer range (React/Next/Expo peer graphs conflict often).
auto-install-peers=true
strict-peer-dependencies=false

# Resolve caret ranges to the newest matching version at lockfile-creation time.
resolution-mode=highest
